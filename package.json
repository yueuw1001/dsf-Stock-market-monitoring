{
  "name": "dsh-us-close-report",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "美国收盘报：富途牛牛美股指数 / 板块 / 个股 / ETF 实时行情看板，点击查看详情、行业关联公司与公司资料。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/futu.js",
    "lib/kline.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueuw1001/dsf-Stock-market-monitoring.git"
  }
}
